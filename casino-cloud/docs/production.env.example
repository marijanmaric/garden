# M1 Casino Cloud: production environment (API). Copy, fill in, keep out of version control.
# The API refuses to start in production (NODE_ENV=production, set by the image) when one of these is missing or weak.
DATABASE_URL=postgres://casino:<password>@<db-host>:5432/casino
JWT_SECRET=<random, 32+ characters, e.g. openssl rand -base64 48>
# Never change after go-live: identity document hashes (duplicate detection) depend on it.
PII_HASH_SECRET=<random, 32+ characters, different from JWT_SECRET>
# Exact browser origin(s) of the web app, comma separated, scheme://host[:port], no path, no *
CORS_ORIGIN=https://casino.example.com
# Production never seeds demo data (refused when true)
AUTO_SEED=false
DEMO_MODE=false
# Web app: public URL of the API as seen by the browser
NEXT_PUBLIC_API_URL=https://api.casino.example.com
